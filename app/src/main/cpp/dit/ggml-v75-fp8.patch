diff --git a/src/ggml-hexagon/htp/fp8-compat.h b/src/ggml-hexagon/htp/fp8-compat.h
new file mode 100644
--- /dev/null
+++ b/src/ggml-hexagon/htp/fp8-compat.h
@@ -0,0 +1,25 @@
+#ifndef HTP_FP8_COMPAT_H
+#define HTP_FP8_COMPAT_H
+#include <stdint.h>
+#include <stddef.h>
+// Power-of-two protection for the transient FP16 HMX result, restored in FP32.
+#define HTP_FP8_HMX_DOWNSCALE (1.0f / 256.0f)
+#define HTP_FP8_HMX_RESTORE 256.0f
+static inline uint16_t htp_fp8_to_fp16_bits(uint8_t x) {
+    const uint16_t sign = (uint16_t)(x & 0x80) << 8;
+    unsigned e = (x >> 3) & 15, m = x & 7;
+    if (e == 15 && m == 7) return sign | 0x7e00;
+    if (e) return sign | (uint16_t)((e + 8) << 10) | (uint16_t)(m << 7);
+    if (!m) return sign;
+    unsigned exponent = 9;
+    while (!(m & 8)) { m <<= 1; --exponent; }
+    return sign | (uint16_t)(exponent << 10) | (uint16_t)((m & 7) << 7);
+}
+static inline size_t htp_fp8_tile_offset(unsigned n, unsigned k) {
+    static const unsigned lane[4] = {0, 2, 1, 3};
+    return (k / 4 * 4 + n / 8) * 32 + n % 8 * 4 + lane[k % 4];
+}
+static inline size_t htp_fp16_tile_offset(unsigned n, unsigned k) {
+    return k / 2 * 64 + n * 2 + k % 2;
+}
+#endif
