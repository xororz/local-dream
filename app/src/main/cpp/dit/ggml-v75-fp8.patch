diff --git a/src/ggml-hexagon/htp/fp8-compat-hvx.h b/src/ggml-hexagon/htp/fp8-compat-hvx.h
new file mode 100644
--- /dev/null
+++ b/src/ggml-hexagon/htp/fp8-compat-hvx.h
@@ -0,0 +1,60 @@
+#ifndef HTP_FP8_COMPAT_HVX_H
+#define HTP_FP8_COMPAT_HVX_H
+#include <stdbool.h>
+#include <hexagon_types.h>
+#include <hexagon_protos.h>
+#include <hvx_hexagon_protos.h>
+#include "fp8-compat.h"
+#if __HVX_LENGTH__ != 128
+#error "FP8 compatibility requires 128-byte HVX vectors"
+#endif
+#define HTP_FP8_VMEM(p) (*(HVX_Vector *)(p))
+static inline HVX_Vector fp8_compat_decode_half(HVX_Vector x) {
+    const HVX_Vector mag = Q6_V_vand_VV(x, Q6_V_vsplat_R(0x007f007f));
+    const HVX_Vector sign = Q6_Vh_vasl_VhR(Q6_V_vand_VV(x, Q6_V_vsplat_R(0x00800080)), 8);
+    const HVX_Vector e = Q6_V_vand_VV(mag, Q6_V_vsplat_R(0x00780078));
+    const HVX_Vector normal = Q6_Vh_vadd_VhVh(Q6_Vh_vasl_VhR(mag, 7), Q6_V_vsplat_R(0x20002000));
+    const HVX_Vector mant = Q6_V_vand_VV(mag, Q6_V_vsplat_R(0x00070007));
+    // v75 qfloat multiplication rounds these exact subnormal values up by one
+    // FP16 bit. Construct all eight encodings with integer operations instead.
+    HVX_Vector sub = Q6_V_vmux_QVV(
+        Q6_Q_vcmp_gt_VhVh(mant, Q6_V_vsplat_R(0x00030003)),
+        Q6_Vh_vadd_VhVh(Q6_Vh_vasl_VhR(mant, 8), Q6_V_vsplat_R(0x1c001c00)),
+        Q6_Vh_vadd_VhVh(Q6_Vh_vasl_VhR(mant, 9), Q6_V_vsplat_R(0x18001800)));
+    sub = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(mant, Q6_V_vsplat_R(0x00010001)),
+                        Q6_V_vsplat_R(0x18001800), sub);
+    sub = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(mant, Q6_V_vzero()), Q6_V_vzero(), sub);
+    HVX_Vector bits = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(e, Q6_V_vzero()), sub, normal);
+    bits = Q6_V_vmux_QVV(Q6_Q_vcmp_eq_VhVh(mag, Q6_V_vsplat_R(0x007f007f)),
+                         Q6_V_vsplat_R(0x7e007e00), bits);
+    return Q6_V_vor_VV(bits, sign);
+}
+
+// Runs on the DSP, so the vector widening/order is checked as well as the scalar oracle.
+static bool fp8_compat_vector_selftest(void) {
+    uint8_t input[256] __attribute__((aligned(128)));
+    uint16_t output[256] __attribute__((aligned(128)));
+    for (unsigned i=0; i<256; ++i) input[i]=(uint8_t)i;
+    for (unsigned i=0; i<256; i+=128) {
+        HVX_VectorPair p=Q6_Wuh_vunpack_Vub(HTP_FP8_VMEM(input+i));
+        HTP_FP8_VMEM(output+i)=fp8_compat_decode_half(Q6_V_lo_W(p));
+        HTP_FP8_VMEM(output+i+64)=fp8_compat_decode_half(Q6_V_hi_W(p));
+    }
+    for (unsigned i=0; i<256; ++i)
+        if (output[i] != htp_fp8_to_fp16_bits(input[i])) return false;
+    return true;
+}
+
+static inline void htp_fp8_tile_to_fp16(uint16_t *dst, const uint8_t *src) {
+    uint16_t decoded[1024] __attribute__((aligned(128)));
+    for (unsigned b = 0; b < 8; ++b) {
+        const HVX_VectorPair expanded = Q6_Wuh_vunpack_Vub(HTP_FP8_VMEM(src + b * 128));
+        HTP_FP8_VMEM(decoded + b * 128) = fp8_compat_decode_half(Q6_V_lo_W(expanded));
+        HTP_FP8_VMEM(decoded + b * 128 + 64) = fp8_compat_decode_half(Q6_V_hi_W(expanded));
+    }
+    for (unsigned n = 0; n < 32; ++n)
+        for (unsigned k = 0; k < 32; ++k)
+            dst[htp_fp16_tile_offset(n, k)] = decoded[htp_fp8_tile_offset(n, k)];
+}
+#undef HTP_FP8_VMEM
+#endif
